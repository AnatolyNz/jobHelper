<?xml version="1.0" encoding="UTF-8"?>
<properties>
    <parsers>
        <parser class="org.apache.tika.parser.DefaultParser">
            <parser class="org.apache.tika.parser.ocr.TesseractOCRParser"/>
        </parser>
    </parsers>

    <parserConfig>
        <tesseractOCRConfig>
            <param name="tesseractPath" type="string" value="/usr/bin/tesseract"/>
            <param name="language" type="string" value="eng"/>
        </tesseractOCRConfig>
    </parserConfig>
</properties>
